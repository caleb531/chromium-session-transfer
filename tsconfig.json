{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome", "vite/client", "node"]
  },
  "include": [
    "src/extension",
    "src/shared",
    "vite.config.ts",
    "svelte.config.js"
  ]
}
