{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome", "vite/client", "node"]
  },
  "include": [
    ".wxt/wxt.d.ts",
    "src/extension",
    "src/shared",
    "scripts",
    "wxt.config.ts",
    "svelte.config.js"
  ]
}
