{
  "name": "chromium-session-transfer",
  "version": "0.1.0",
  "private": true,
  "description": "Transfer selected Brave tabs and their stored sessions to Chrome",
  "author": "Caleb Evans",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "icons:generate": "node scripts/generate-icons.ts",
    "dev": "wxt",
    "build": "wxt build && pnpm build:host",
    "build:host": "tsc -p src/host/tsconfig.json && cp src/host/loading-page.html dist/host/loading-page.html",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p src/host/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "host:install": "node dist/host/install.js",
    "host:reset-permissions": "node dist/host/install.js --reset-permissions",
    "host:uninstall": "node dist/host/install.js --uninstall",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "puppeteer-core": "^25.18.1",
    "tldts": "^7.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "wxt": "^0.21.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "ignore"
    }
  }
}
