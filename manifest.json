{
  "manifest_version": 3,
  "name": "Chromium Session Transfer",
  "version": "0.1.0",
  "description": "Transfer selected tabs and their stored sessions between Chromium browsers",
  "minimum_chrome_version": "144",
  "permissions": ["tabs", "cookies", "scripting", "storage", "nativeMessaging"],
  "optional_host_permissions": ["*://*/*"],
  "icons": {
    "16": "app-icon-16.png",
    "32": "app-icon-32.png",
    "48": "app-icon-48.png",
    "128": "app-icon-128.png"
  },
  "background": {
    "service_worker": "src/extension/background.ts",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "app-icon-16.png",
      "32": "app-icon-32.png"
    },
    "default_title": "Transfer sessions"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Choose tabs to transfer"
    }
  },
  "key": ""
}
